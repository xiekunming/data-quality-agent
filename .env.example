# ===== GLM / 私有化模型网关 =====
# 智谱开放平台 API Key（https://open.bigmodel.cn）；换私有化网关时填网关的 key
GLM_API_KEY=
# Anthropic 协议客户端用的 base_url（agent 代码不读此项，可不填）
GLM_API_BASE_URL=

# ===== 钉钉企业内部应用机器人（Stream 模式）=====
# open-dev.dingtalk.com → 应用 → 凭证与基础信息
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# ===== StarRocks（agent_meta 存储 + 业务库只读核查，dq_agent 专用账号）=====
SR_HOST=
SR_PORT=
SR_USER=
SR_PASSWORD=
SR_DB=

# ===== Airflow REST API（basic auth，Viewer 只读账号即可）=====
# 本地示例：AIRFLOW_BASE_URL=http://127.0.0.1:8080，SR_PORT=9030，SR_DB=agent_meta
AIRFLOW_BASE_URL=
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
SR_BUSINESS_DB=demo_dw     # 核查工具默认业务库（须对该库只读）
